{
  "openapi": "3.1.0",
  "info": {
    "title": "webhook-delivery-platform",
    "version": "1.0.0",
    "description": "Send an event once; the service delivers it at least once to every subscribed endpoint, signed with Standard Webhooks, retrying for about 23 hours and recording every attempt.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Applications"
    },
    {
      "name": "Endpoints"
    },
    {
      "name": "Messages"
    },
    {
      "name": "Deliveries"
    },
    {
      "name": "Operations"
    }
  ],
  "paths": {
    "/v1/apps": {
      "post": {
        "operationId": "createApp",
        "summary": "Create an application",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "200": {
            "description": "An earlier create with the same Idempotency-Key; returns that object",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/v1/apps/{app}": {
      "get": {
        "operationId": "getApp",
        "summary": "Read an application",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          }
        ],
        "responses": {
          "200": {
            "description": "The application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/apps/{app}/endpoints": {
      "post": {
        "operationId": "createEndpoint",
        "summary": "Create an endpoint",
        "tags": [
          "Endpoints"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEndpointRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new endpoint, including its signing secret (returned only here and on rotation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "200": {
            "description": "An earlier create with the same Idempotency-Key; returns that object",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      },
      "get": {
        "operationId": "listEndpoints",
        "summary": "List endpoints",
        "tags": [
          "Endpoints"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of endpoints, ordered by id, without secrets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndpointList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/apps/{app}/endpoints/{ep}": {
      "get": {
        "operationId": "getEndpoint",
        "summary": "Read an endpoint",
        "tags": [
          "Endpoints"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "ep",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint id (ep_…)"
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint, without its secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "operationId": "updateEndpoint",
        "summary": "Change an endpoint",
        "tags": [
          "Endpoints"
        ],
        "description": "Only the fields given change. Setting status to active also re-enables a disabled endpoint and clears its failure history.",
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "ep",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint id (ep_…)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEndpointRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated endpoint, without its secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      },
      "delete": {
        "operationId": "deleteEndpoint",
        "summary": "Delete an endpoint and its deliveries",
        "tags": [
          "Endpoints"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "ep",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint id (ep_…)"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/apps/{app}/endpoints/{ep}/secret/rotate": {
      "post": {
        "operationId": "rotateSecret",
        "summary": "Rotate the signing secret",
        "tags": [
          "Endpoints"
        ],
        "description": "Without a body a secret is generated. For 24 hours after a rotation each request carries signatures for both the old and the new secret.",
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "ep",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint id (ep_…)"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RotateSecretRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The endpoint with its new secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/v1/apps/{app}/endpoints/{ep}/enable": {
      "post": {
        "operationId": "enableEndpoint",
        "summary": "Re-enable an endpoint",
        "tags": [
          "Endpoints"
        ],
        "description": "Same as PATCH with status active: clears the failure history so the endpoint starts with a closed circuit.",
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "ep",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint id (ep_…)"
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint, active again, without its secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/apps/{app}/endpoints/{ep}/replay": {
      "post": {
        "operationId": "replayEndpoint",
        "summary": "Redeliver an endpoint's dead deliveries",
        "tags": [
          "Deliveries"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "ep",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint id (ep_…)"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Replay dead deliveries created at or after this time (RFC 3339). Required here or in the body."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayEndpointRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "How many deliveries were queued again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayEndpointResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/v1/apps/{app}/messages": {
      "post": {
        "operationId": "sendMessage",
        "summary": "Send an event",
        "tags": [
          "Messages"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The message was stored and fanned out to every subscribed active endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "200": {
            "description": "An earlier send with the same Idempotency-Key; nothing new was queued",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/v1/apps/{app}/messages/{msg}/deliveries": {
      "get": {
        "operationId": "listDeliveries",
        "summary": "List a message's deliveries",
        "tags": [
          "Deliveries"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "msg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Message id (msg_…)"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of deliveries, ordered by id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/apps/{app}/deliveries/{del}/attempts": {
      "get": {
        "operationId": "listAttempts",
        "summary": "List a delivery's attempts",
        "tags": [
          "Deliveries"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "del",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delivery id (del_…)"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of attempts, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/apps/{app}/deliveries/{del}/replay": {
      "post": {
        "operationId": "replayDelivery",
        "summary": "Send a delivery again",
        "tags": [
          "Deliveries"
        ],
        "parameters": [
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application id (app_…)"
          },
          {
            "name": "del",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delivery id (del_…)"
          }
        ],
        "responses": {
          "202": {
            "description": "The delivery, pending again with a fresh retry schedule and the same webhook-id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delivery"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "description": "The delivery is still pending or in flight",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness",
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Readiness",
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "Postgres is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "Postgres is not reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "This API description",
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Prometheus metrics",
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "Metrics in the Prometheus text format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The API_KEY the service was started with"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "schema": {
          "type": "string",
          "maxLength": 255
        },
        "description": "A repeat with the same key returns the first result instead of creating another"
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "next_cursor from the previous page"
      }
    },
    "headers": {
      "IdempotentReplayed": {
        "schema": {
          "type": "string",
          "enum": [
            "true"
          ]
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed JSON, query parameter or header",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or wrong API key",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such object in this application",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Invalid": {
        "description": "A field failed validation",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "App": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "app_3f2a…"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "description": "One of the operator's customers"
      },
      "Endpoint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "app_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "secret": {
            "type": "string",
            "description": "whsec_… signing secret; only in create and rotate responses"
          },
          "event_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Event types delivered here; empty means every type the operator sends"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "disabled"
            ]
          },
          "max_in_flight": {
            "type": "integer",
            "description": "Concurrent sends allowed, across all dispatchers"
          },
          "rate_limit": {
            "type": "integer",
            "description": "Requests per second; 0 means unlimited"
          },
          "consecutive_failures": {
            "type": "integer"
          },
          "failing_since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "circuit_open_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "disabled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "app_id",
          "url",
          "event_types",
          "status",
          "max_in_flight",
          "rate_limit",
          "consecutive_failures",
          "failing_since",
          "circuit_open_until",
          "disabled_at",
          "created_at",
          "updated_at"
        ],
        "description": "A URL an application receives webhooks at"
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          },
          "endpoint_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "in_flight",
              "succeeded",
              "dead"
            ]
          },
          "attempt_count": {
            "type": "integer"
          },
          "next_attempt_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "message_id",
          "endpoint_id",
          "state",
          "attempt_count",
          "next_attempt_at",
          "created_at",
          "updated_at"
        ],
        "description": "One message going to one endpoint"
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "delivery_id": {
            "type": "string"
          },
          "attempted_at": {
            "type": "string",
            "format": "date-time"
          },
          "status_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Null when no response arrived"
          },
          "latency_ms": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "description": "Network or timeout error, if any"
          },
          "response_body": {
            "type": "string",
            "description": "First 4 KB of the response"
          }
        },
        "required": [
          "id",
          "delivery_id",
          "attempted_at",
          "status_code",
          "latency_ms"
        ],
        "description": "One HTTP call made for a delivery"
      },
      "EndpointList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Endpoint"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Pass as ?cursor= for the next page; absent on the last page"
          }
        },
        "required": [
          "data"
        ]
      },
      "DeliveryList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Delivery"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Pass as ?cursor= for the next page; absent on the last page"
          }
        },
        "required": [
          "data"
        ]
      },
      "AttemptList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Pass as ?cursor= for the next page; absent on the last page"
          }
        },
        "required": [
          "data"
        ]
      },
      "CreateAppRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateEndpointRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "event_types": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255
            },
            "maxItems": 100
          },
          "secret": {
            "type": "string",
            "description": "whsec_ followed by base64 of at least 16 bytes; generated when omitted"
          },
          "max_in_flight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 4
          },
          "rate_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "Requests per second; 0 means unlimited"
          }
        },
        "required": [
          "url"
        ]
      },
      "UpdateEndpointRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "event_types": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255
            },
            "maxItems": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused"
            ]
          },
          "max_in_flight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "rate_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "0 removes the limit"
          }
        }
      },
      "RotateSecretRequest": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "New whsec_ secret; generated when omitted"
          }
        }
      },
      "ReplayEndpointRequest": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReplayEndpointResponse": {
        "type": "object",
        "properties": {
          "replayed": {
            "type": "integer"
          }
        },
        "required": [
          "replayed"
        ]
      },
      "SendMessageRequest": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 255
          },
          "payload": {
            "description": "Any JSON value except null"
          }
        },
        "required": [
          "event_type",
          "payload"
        ]
      },
      "SendMessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The message id, sent as the webhook-id header"
          },
          "deliveries": {
            "type": "integer",
            "description": "How many endpoints the message fanned out to"
          }
        },
        "required": [
          "id",
          "deliveries"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "description": "RFC 9457 problem details"
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
